# SYNTHETIC - hand-made drm-harness records for scripts/harness-summary.py --self-test.
# NOT measurements from a real board: never quote these numbers as evidence.
# Scenario `combos` on a DRM master fd: layer combinations through the planner
# and atomic TEST_ONLY, nothing committed. The summary must therefore report
# every latency metric as `not measured` and take the error count from
# `combos_result`.
harness version=0.1.0 scenario=combos args="--connector LVDS --profile imx95 combos"
session scenario=combos source=master device=/dev/dri/card0 driver=imx-drm master=yes profile=imx95 producers=local
output index=0 id=91 connector=LVDS-1 width=1280 height=800 refresh_mhz=60000 mode=1280x800 vrefresh=60 clock_khz=75900 selected=yes
plane id=86 kind=primary zpos=fixed:0 on_output=yes alpha=true blend_mask=24 scaling=false formats=XR24
plane id=143 kind=overlay zpos=0..7 on_output=yes alpha=true blend_mask=24 scaling=true formats=XR24,AR24
combo name=1-layer layers=1 expect=accept planner=accept planner_planes=86 validate_us=650 test_only=accept planes=86 assigned=1 layer0="plane:86,zpos:0,dst:0,0,1280x800" as_expected=true
combo name=3-layers layers=3 expect=planner-refuse planner=refuse planner_reason="no plane left for layer 2" test_only=not-run as_expected=true
combo name=blend-coverage layers=2 expect=accept planner=accept planner_planes=86,143 validate_us=700 test_only=refuse candidates=2 as_expected=true
combo name=scale-down layers=2 expect=accept planner=accept planner_planes=86,143 validate_us=720 test_only=accept planes=86,143 assigned=2 layer0="plane:86,zpos:0,dst:0,0,1280x800" layer1="plane:143,zpos:1,dst:640,400,640x400" as_expected=true
combo name=unsupported-format-HWLX layers=2 expect=planner-refuse planner=refuse planner_reason="format HWLX unsupported" test_only=not-run as_expected=true
combo name=off-screen layers=2 expect=any planner=accept planner_planes=86,143 validate_us=680 test_only=error error="validate: Invalid argument (os error 22)" as_expected=true
combos_result combos=6 accepted=2 planner_refused=2 test_only_refused=1 errors=1 planes_on_output=2
resources scenario=combos wall_ms=600 cpu_user_ms=60 cpu_sys_ms=10 cpu_pct=11.7 rss_kib=3968 peak_rss_kib=4096
VERDICT combos PASS 2 accepted, 2 refused by the planner, 1 refused by TEST_ONLY, nothing committed
